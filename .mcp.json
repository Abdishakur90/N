{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ]
    },
    "boardui": {
      "command": "npx",
      "args": [
        "-y",
        "boardui@latest",
        "mcp"
      ],
      "env": {
        "NODE_USE_ENV_PROXY": "1",
        "BOARDUI_TELEMETRY_DISABLED": "1"
      }
    }
  }
}
